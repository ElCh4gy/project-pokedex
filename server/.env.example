# Cadena de conexión a MongoDB (en producción, la de Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/pokedex
# Puerto del servidor
PORT=3001
# Origen del front end permitido por CORS
CLIENT_ORIGIN=http://localhost:5173
# Clave para firmar los tokens. Genera la tuya con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'));"
JWT_SECRET=cambia-esta-clave-de-ejemplo
